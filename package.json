{
  "name": "mythic",
  "version": "1.0.0",
  "private": true,
  "description": "A personal dashboard for your tasks, habits and day. Runs on your own machine, keeps your data in one SQLite file.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H ${HOST:-127.0.0.1}",
    "lint": "eslint",
    "test": "MYTHIC_TIMEZONE=Europe/London node --test \"lib/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "framer-motion": "^12.38.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4"
  }
}
