# Copy to .env.local (or set these in your environment). Every line is optional.

# Where Mythic keeps its database and uploaded photos. Default: ./data
# MYTHIC_DATA_DIR=/var/lib/mythic

# The timezone before onboarding sets one (onboarding asks). Default: UTC
# MYTHIC_TIMEZONE=Europe/London

# Without a password Mythic only answers on this machine (localhost).
# Set one to open it from your phone or another computer; it then asks for it.
# MYTHIC_PASSWORD=choose-a-long-passphrase

# Signs the session cookie. Default: derived from MYTHIC_PASSWORD.
# MYTHIC_SECRET=a-long-random-string

# The address `npm start` listens on. Default: 127.0.0.1 (this machine only).
# Use 0.0.0.0 together with MYTHIC_PASSWORD to listen on your network.
# HOST=0.0.0.0
# PORT=3000

# Turn the background worker (calendar refresh, reminders, Telegram) off.
# MYTHIC_WORKER=off

# A sleep file somewhere other than iCloud Drive's Shortcuts/Mythic/sleep.txt.
# MYTHIC_HEALTH_SLEEP_FILE=/path/to/sleep.txt
